{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "doc-kit bricks (standard/bricks.json)",
  "description": "The bricks of a documentation project and their presets (ARCHITECTURE.md §6.18).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "presets", "bricks"],
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "version": { "const": 1 },
    "presets": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
    },
    "bricks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/brick" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)?$" },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fr"],
      "properties": { "en": { "type": "string", "minLength": 1 }, "fr": { "type": "string", "minLength": 1 } }
    },
    "step": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "enum": ["inputs", "facts", "audit"] },
            "action": { "enum": ["fetch", "ingest"] },
            "source": { "type": "string" },
            "tools": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent", "per"],
          "properties": {
            "agent": { "type": "string", "minLength": 1 },
            "per": { "enum": ["page", "feature", "once"] }
          }
        }
      ]
    },
    "freshness": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "files"],
          "properties": {
            "rule": { "const": "envelope" },
            "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "maxAgeDays": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "part"],
          "properties": { "rule": { "const": "inputs" }, "part": { "enum": ["repos", "docs"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule"],
          "properties": { "rule": { "const": "volatile" } }
        }
      ]
    },
    "brick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "steps", "freshness"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["inputs", "facts", "report"] },
        "title": { "$ref": "#/$defs/text" },
        "needs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "requires": { "type": "array", "items": { "enum": ["network", "tools"] } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "freshness": { "$ref": "#/$defs/freshness" }
      }
    }
  }
}
