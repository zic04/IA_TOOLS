{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-kit/schemas/capture-plan.schema.json",
  "title": "Capture plan entry (captures/plans/*.mjs → CAPTURES[i])",
  "description": "One capture of a plan (ARCHITECTURE.md §6.3; full syntax at the top of engine/capture/plans.mjs). Validated after the legacy normalisation (§6.7). Accepts what the engine executes (engine/capture/*.mjs), no more: strings or regular expressions where a text is matched; `eval` accepts a function or a string; margins may be negative (a tighter zone or frame); `nth` may be negative (counted from the last match); a viewport side, a `wheel.steps` count and the waits only need to be possible (≥ 1 px, ≥ 0). Exactly one kind per target and per action is checked by the engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "route"],
  "$defs": {
    "matchText": { "type": ["string", "object"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/matchText" },
        "text": { "$ref": "#/$defs/matchText" },
        "field": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/matchText" },
        "placeholder": { "$ref": "#/$defs/matchText" },
        "css": { "type": "string", "minLength": 1 },
        "block": { "type": "string", "minLength": 1 },
        "exact": { "type": "boolean" },
        "nth": { "type": "integer" },
        "last": { "type": "boolean" },
        "has": { "$ref": "#/$defs/matchText" },
        "within": { "$ref": "#/$defs/target" },
        "up": { "type": "integer", "minimum": 0 },
        "framed": { "type": "boolean" },
        "margin": { "type": "number" },
        "marginY": { "type": "number" },
        "side": { "enum": ["corner", "right", "bottom", "bottom-right"] },
        "caption": { "type": "string" }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "union": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
        "role": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/matchText" },
        "text": { "$ref": "#/$defs/matchText" },
        "field": { "type": "string", "minLength": 1 },
        "label": { "$ref": "#/$defs/matchText" },
        "placeholder": { "$ref": "#/$defs/matchText" },
        "css": { "type": "string", "minLength": 1 },
        "block": { "type": "string", "minLength": 1 },
        "exact": { "type": "boolean" },
        "nth": { "type": "integer" },
        "last": { "type": "boolean" },
        "has": { "$ref": "#/$defs/matchText" },
        "within": { "$ref": "#/$defs/target" },
        "up": { "type": "integer", "minimum": 0 },
        "framed": { "type": "boolean" },
        "margin": { "type": "number" },
        "side": { "enum": ["corner", "right", "bottom", "bottom-right"] },
        "caption": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "click": { "$ref": "#/$defs/target" },
        "hover": { "$ref": "#/$defs/target" },
        "type": { "$ref": "#/$defs/target" },
        "select": { "$ref": "#/$defs/target" },
        "scroll": { "$ref": "#/$defs/target" },
        "press": { "type": "string", "minLength": 1 },
        "wait": { "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/$defs/target" }] },
        "wheel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "steps": { "type": "integer", "minimum": 0 },
            "direction": { "enum": [-1, 1] }
          }
        },
        "eval": {},
        "value": { "type": ["string", "number", "array", "object"] },
        "options": { "type": "object" }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "title": { "type": "string" },
    "route": { "type": "string", "pattern": "^/" },
    "context": { "type": "string", "minLength": 1 },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "lat": { "type": "number", "minimum": -85.06, "maximum": 85.06 },
        "zoom": { "type": "number" },
        "x": { "type": ["number", "string"] },
        "y": { "type": ["number", "string"] },
        "z": { "type": ["number", "string"] }
      }
    },
    "storage": { "type": "object" },
    "delay": { "type": "number", "minimum": 0 },
    "settle": { "type": "number", "minimum": 0 },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "frame": { "$ref": "#/$defs/target" },
    "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
    "masks": { "type": "array", "items": { "$ref": "#/$defs/target" } }
  }
}
