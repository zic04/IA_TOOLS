{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-kit/schemas/toc.schema.json",
  "title": "content/toc.json",
  "description": "Site outline (ARCHITECTURE.md §6.1). Legacy French-keyed files (contenu/sommaire.json) are normalised by engine/project/legacy.mjs before validation. `product` is deprecated: the name comes from doc.config.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "sections"],
  "$defs": {
    "pageId": { "type": "string", "pattern": "^[^\\s~#]+$" },
    "strings": { "type": "array", "items": { "type": "string" } }
  },
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "product": { "type": "string" },
    "tagline": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "groups"],
        "properties": {
          "id": { "$ref": "#/$defs/pageId" },
          "title": { "type": "string", "minLength": 1 },
          "shortTitle": { "type": "string" },
          "icon": { "type": "string" },
          "subtitle": { "type": "string" },
          "featured": { "type": "boolean" },
          "highlights": { "$ref": "#/$defs/strings" },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pages"],
              "properties": {
                "title": { "type": "string" },
                "pages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "title"],
                    "properties": {
                      "id": { "$ref": "#/$defs/pageId" },
                      "title": { "type": "string", "minLength": 1 },
                      "menuTitle": { "type": "string" },
                      "summary": { "type": "string" },
                      "level": { "enum": [1, 2] },
                      "template": { "type": "string", "pattern": "^[a-z-]+$" },
                      "routes": { "$ref": "#/$defs/strings" },
                      "permissions": { "$ref": "#/$defs/strings" },
                      "file": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "steps"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "steps": { "type": "array", "items": { "$ref": "#/$defs/pageId" } }
        }
      }
    },
    "suggestions": { "type": "array", "items": { "$ref": "#/$defs/pageId" } }
  }
}
