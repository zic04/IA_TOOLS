{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-kit/schemas/config.schema.json",
  "title": "doc.config.mjs",
  "description": "Configuration of a documentation project (ARCHITECTURE.md §3). Neutral defaults: no cookie, no CSS framework selector, no brand colour, no geolocation unless asked for. Strict validation: an unknown key is an error (exit code 2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["product"],
  "$defs": {
    "colour": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 200 },
        "height": { "type": "integer", "minimum": 200 }
      }
    },
    "adapter": {
      "type": "string",
      "pattern": "^([a-z0-9-]+|local:.+)$"
    },
    "folder": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^<>:\"|?*]+$"
    },
    "text": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["other"],
          "properties": {
            "zero": { "type": "string" },
            "one": { "type": "string" },
            "two": { "type": "string" },
            "few": { "type": "string" },
            "many": { "type": "string" },
            "other": { "type": "string" }
          }
        }
      ]
    }
  },
  "properties": {
    "kit": {
      "type": "string",
      "default": "*",
      "description": "Accepted kit version range (^1.0.0, ~0.1.0, >=0.1.0, *). Outside the range: exit code 3."
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "language": { "enum": ["en", "fr"], "default": "en" },
    "languages": {
      "anyOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string" } }],
      "default": null,
      "description": "One source, several languages (ARCHITECTURE.md §6.12): at least two, unique, each one a language the kit speaks; the first is the source (language is then derived from it). Cross-field rules (languagesMin, languagesDuplicate, languagesUnsupported, languagesSource) are checked after this schema, where the known languages and the sibling `language` are available."
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "description": "Generated file, relative to the project. Default: dist/<name>-Documentation.html."
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "Folder names, relative to the project (older projects: { content: \"contenu\", diagrams: \"schemas\" }).",
      "properties": {
        "content": { "$ref": "#/$defs/folder", "default": "content" },
        "images": { "$ref": "#/$defs/folder", "default": "images" },
        "diagrams": { "$ref": "#/$defs/folder", "default": "diagrams" },
        "facts": { "$ref": "#/$defs/folder", "default": "facts", "description": "Where `doc-kit facts` writes one file per source (ARCHITECTURE.md §6.9)." },
        "sync": { "$ref": "#/$defs/folder", "default": ".", "description": "Where sync.json lives (ARCHITECTURE.md §6.10)." },
        "translations": { "$ref": "#/$defs/folder", "default": "translations", "description": "Translations of content/ (ARCHITECTURE.md §6.12); must not be inside paths.content." }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "file": { "type": ["string", "null"], "default": null },
        "pattern": { "type": "string", "minLength": 1, "default": "\"version\"\\s*:\\s*\"([^\"]+)\"" },
        "fallback": { "type": "string", "minLength": 1, "default": "0.0.0" }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "url": { "type": ["string", "null"], "default": null },
        "dir": { "type": ["string", "null"], "default": null, "description": "Application root (its code), relative to the project; written by init, read by the skill's briefs and by doctor." }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "properties": {
        "adapter": { "$ref": "#/$defs/adapter", "default": "manual" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "mode": { "enum": ["app", "none"], "default": "app", "description": "\"app\": the screens are captured; \"none\": no screenshot (capture and connect refuse, annotated is n/a)." },
        "target": { "enum": ["local", "demo", "production"], "default": "local", "description": "Where the screenshots are taken (mode \"app\"): \"local\" the application on this machine, \"demo\" a demo copy, \"production\" the real application: read-only always (readOnly false is refused), a banner and a confirmation before each capture run, demo refused." },
        "plans": { "type": "string", "minLength": 1, "default": "captures/plans" },
        "setup": { "type": ["string", "null"], "default": null },
        "locale": { "type": ["string", "null"], "default": null },
        "timezone": { "type": "string", "minLength": 1, "default": "UTC" },
        "scale": { "enum": [1, 2], "default": 1, "description": "Pixel density of the captures: 2 for images that stay sharp on high-density (Retina) screens, about 2.3 times heavier." },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16, "default": 4, "description": "Captures taken at the same time, each in its own browser context (production: always 1)." },
        "clock": { "type": ["string", "null"], "default": null, "description": "A fixed date and time for every capture (ISO, e.g. 2026-01-15T09:00:00Z): \"today\", relative dates and countdowns are the same on every run. null: the real clock." },
        "viewports": {
          "type": "object",
          "default": { "desktop": { "width": 1600, "height": 1000 }, "mobile": { "width": 390, "height": 844 } },
          "additionalProperties": { "$ref": "#/$defs/viewport" }
        },
        "webpQuality": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.82 },
        "geolocation": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["latitude", "longitude"],
              "properties": {
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
              }
            }
          ],
          "default": null
        },
        "storage": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" }
        },
        "cookies": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string" }
            }
          }
        },
        "selectors": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "block": { "type": ["string", "null"], "default": null },
            "frame": { "type": ["string", "null"], "default": null }
          }
        },
        "map": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "z"],
              "properties": {
                "x": { "type": "string", "minLength": 1 },
                "y": { "type": "string", "minLength": 1 },
                "z": { "type": "string", "minLength": 1 }
              }
            }
          ],
          "default": null
        },
        "forbidden": { "type": "array", "items": { "type": "string" }, "default": [] },
        "readOnly": { "enum": ["auto", true, false], "default": "auto" },
        "sessionRefresh": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "reason"],
              "properties": {
                "method": { "enum": ["POST"], "default": "POST" },
                "path": { "type": "string", "pattern": "^/" },
                "json": { "anyOf": [{ "type": "null" }, { "type": "object" }], "default": null },
                "reason": { "type": "string", "minLength": 20 }
              }
            }
          ],
          "default": null,
          "description": "The only exception to the read-only lock (ARCHITECTURE.md §6.3a): one request that renews a short-lived session (path relative to app.url), sent once before each capture run, outside any page; every request of the pages stays GET/HEAD/OPTIONS. `reason` records the owner's decision and why the endpoint writes nothing."
        },
        "compareThreshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.005, "description": "`capture --compare` (ARCHITECTURE.md §6.10): share of differing pixels above which the image is replaced." },
        "languages": {
          "type": "object",
          "default": {},
          "description": "One entry per language captured with `capture --lang <l>` (ARCHITECTURE.md §6.12); every field optional, merged over the fields above.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "locale": { "type": ["string", "null"], "default": null },
              "cookies": {
                "type": "array",
                "default": [],
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["name", "value"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "value": { "type": "string" }
                  }
                }
              },
              "storage": { "type": "object", "default": {}, "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    },
    "masking": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "env": { "type": "array", "items": { "type": "string" }, "default": [] },
        "exclude": { "type": ["string", "null"], "default": "localhost|127\\.0\\.0\\.1" },
        "guid": { "type": "boolean", "default": true },
        "patterns": { "type": "array", "items": { "type": "string" }, "default": [] },
        "allow": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] }
      }
    },
    "coverage": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["adapter"],
        "properties": {
          "adapter": { "$ref": "#/$defs/adapter" }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "key": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+$", "default": null },
        "logo": { "type": ["string", "null"], "default": null },
        "colors": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/colour" } },
        "dark": { "type": "object", "default": {}, "additionalProperties": { "$ref": "#/$defs/colour" } },
        "icons": { "type": "object", "default": {}, "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "spaces": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "Exports of the spaces declared in content/toc.json (ARCHITECTURE.md §6.1a); ignored without spaces.",
      "properties": {
        "export": { "type": "boolean", "default": true, "description": "false: the full site alone, no export per space." },
        "output": { "type": ["string", "null"], "minLength": 1, "default": null, "description": "Path of each export, relative to the project, containing {space}. Default: the output with -{space} before its extension." }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "`doc-kit sync` (ARCHITECTURE.md §6.10): what the documentation must follow after a change of the application.",
      "properties": {
        "labels": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Message files whose labels are followed (globs, relative to the project); default: the `messages` of the i18n-registry coverage adapters." }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "Prices per million tokens, by model (ARCHITECTURE.md §6.11), read by `sync --estimate`. No default value: prices change and differ by contract. `routing`: the model of each brief (§6.11), over the kit's defaults.",
      "properties": {
        "currency": { "type": ["string", "null"], "default": null },
        "routing": { "type": "object", "default": {}, "additionalProperties": { "type": "string", "minLength": 1 } },
        "prices": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "output"],
            "properties": {
              "input": { "type": "number", "minimum": 0 },
              "output": { "type": "number", "minimum": 0 },
              "cacheRead": { "type": "number", "minimum": 0 },
              "cacheWrite": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "Security and maintainability reviews on demand (ARCHITECTURE.md §6.13): guard patterns for the `api` facts source and `probe`'s access-control matrix, example path parameters for `probe`, and a local semgrep rules folder.",
      "properties": {
        "guards": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "role": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Regular expressions (strings, case-insensitive); replaces the built-in role guard pattern when not empty." },
            "user": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Regular expressions (strings, case-insensitive); replaces the built-in user guard pattern when not empty." }
          }
        },
        "params": { "type": "object", "default": {}, "additionalProperties": { "type": "string" }, "description": "Path parameter name → example value, to fill the routes `probe` checks for access control; a route with a parameter not given here is skipped." },
        "semgrep": { "type": ["string", "null"], "default": null, "description": "Local semgrep rules folder, relative to the project. Without it, `facts --tools` never runs semgrep (never --config auto, which downloads rules)." }
      }
    },
    "statuses": {
      "type": "object",
      "default": {},
      "description": "{ \"0\": [\"st-0\", \"0 · paid\"] }: [colour (token name or #hex), label].",
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "texts": {
      "type": "object",
      "default": {},
      "description": "i18n overrides: { \"home.primaryAction\": \"Explore the editors\" }.",
      "additionalProperties": { "$ref": "#/$defs/text" }
    },
    "feedback": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^(https?:|mailto:)" }
          }
        }
      ],
      "default": null
    },
    "extra": { "type": "object", "default": {} }
  }
}
