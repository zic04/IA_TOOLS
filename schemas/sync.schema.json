{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-kit/schemas/sync.schema.json",
  "title": "sync.json",
  "description": "The reference of `doc-kit sync` (ARCHITECTURE.md §6.10): what was checked, and against which state of the application. Written by `--mark`, read by the build (page footer) and by the report. Strict at the top level; each item tolerates unknown fields, so that a future kit version can add to them without breaking an older reader.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generator", "app", "pages"],
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "hash": { "type": "string", "minLength": 1 }
  },
  "properties": {
    "generator": { "type": "string", "minLength": 1 },
    "app": {
      "type": "object",
      "additionalProperties": true,
      "required": ["commit", "version", "date"],
      "properties": {
        "commit": { "type": ["string", "null"] },
        "version": { "type": "string" },
        "date": { "$ref": "#/$defs/date" }
      }
    },
    "pages": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["verified", "version", "source"],
        "properties": {
          "verified": { "$ref": "#/$defs/date" },
          "version": { "type": "string" },
          "source": { "$ref": "#/$defs/hash" },
          "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } },
          "declared": { "type": "array", "items": { "type": "string" } },
          "captures": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "proofs": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["hash", "text"],
        "properties": {
          "hash": { "$ref": "#/$defs/hash" },
          "text": { "type": "string" }
        }
      }
    },
    "labels": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "inventory": {
      "type": "object",
      "default": {},
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "captures": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["plan"],
        "properties": {
          "plan": { "$ref": "#/$defs/hash" },
          "route": { "type": "string" }
        }
      }
    }
  }
}
