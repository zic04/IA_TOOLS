// Fixture: a Prisma schema, for the `db` facts source.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id       String @id @default(uuid())
  status   String
  amount   Float
  tenantId String

  @@map("orders")
}

model Customer {
  id    String @id @default(uuid())
  email String @unique
}
