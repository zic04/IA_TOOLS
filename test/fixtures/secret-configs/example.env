# Copy to .env and fill in. Never commit the .env file itself.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://orders@localhost:5432/orders
DB_PASSWORD=changeme
POSTGRES_PASSWORD=postgres
JWT_SECRET=<generate-a-long-random-string>
SESSION_SECRET=change-me-in-production
STRIPE_SECRET_KEY=your-stripe-secret-key
API_KEY=
GITHUB_TOKEN=${GITHUB_TOKEN}
SMTP_PASSWORD=********
REDIS_PASSWORD=$REDIS_PASSWORD
PASSWORD_RESET_URL=/account/reset-password
TOKEN_URL=https://login.acme.io/oauth2/v2.0/token
SECRET_NAME=orders-db-credentials
