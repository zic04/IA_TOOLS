<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="acme" value="https://pkgs.acme.io/nuget/v3/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <acme>
      <add key="Username" value="build-agent" />
      <add key="ClearTextPassword" value="%NUGET_ACME_PASSWORD%" />
    </acme>
  </packageSourceCredentials>
  <appSettings>
    <add key="DbPassword" value="$(DbPassword)" />
    <add key="ApiTokenHeader" value="X-Api-Token" />
  </appSettings>
</configuration>
