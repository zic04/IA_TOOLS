{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=Orders;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "ClientId": "orders-api",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc"
  },
  "Jwt": {
    "Issuer": "https://orders.acme.io",
    "Secret": "__REPLACE_AT_DEPLOY__",
    "SecretKeyVaultName": "kv-orders-prod",
    "TokenLifetime": "01:00:00"
  },
  "Smtp": { "Host": "smtp.acme.io", "Password": "#{SmtpPassword}#", "ApiKey": "API_KEY_FROM_VAULT" },
  "PasswordPolicy": { "RequiredLength": 12, "RequireDigit": true },
  "KeyVault": { "Uri": "https://kv-orders-prod.vault.azure.net/", "SecretName": "orders-db-password" },
  "OpenAI": { "ApiKey": "OPENAI_API_KEY" },
  "ApiKeyHeaderName": "X-Api-Key",
  "AllowedHosts": "*"
}
