{
  "$schema": "../schemas/bricks.schema.json",
  "description": "The bricks of a documentation project (ARCHITECTURE.md §6.18): each part that can be run again on its own. `needs`: bricks that must be fresh first. `steps`: the deterministic commands the kit runs, and the briefs the skill's agents run. `freshness`: how the kit tells that a brick is up to date. Presets name sets of bricks for `bricks.enabled` and `doc-kit bricks run`.",
  "version": 1,
  "presets": {
    "inputs": ["inputs.repos", "inputs.docs"],
    "facts": [
      "facts.dependencies",
      "facts.stack",
      "facts.env",
      "facts.api",
      "facts.screens",
      "facts.db",
      "facts.infra",
      "facts.behaviours",
      "facts.agents",
      "facts.secrets",
      "facts.security",
      "facts.quality",
      "facts.tests",
      "facts.modules",
      "facts.history"
    ],
    "full": ["inputs", "facts", "facts.tools", "doc-audit"]
  },
  "bricks": [
    {
      "id": "inputs.repos",
      "kind": "inputs",
      "title": { "en": "Shared repositories of the sources", "fr": "Dépôts partagés des sources" },
      "requires": ["network"],
      "steps": [{ "command": "inputs", "action": "fetch" }],
      "freshness": { "rule": "inputs", "part": "repos" }
    },
    {
      "id": "inputs.docs",
      "kind": "inputs",
      "title": { "en": "Documents of the sources, converted", "fr": "Documents des sources, convertis" },
      "steps": [{ "command": "inputs", "action": "ingest" }],
      "freshness": { "rule": "inputs", "part": "docs" }
    },
    {
      "id": "facts.dependencies",
      "kind": "facts",
      "title": { "en": "Dependencies", "fr": "Dépendances" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "dependencies" }],
      "freshness": { "rule": "envelope", "files": ["dependencies"] }
    },
    {
      "id": "facts.env",
      "kind": "facts",
      "title": { "en": "Environment variables", "fr": "Variables d'environnement" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "env" }],
      "freshness": { "rule": "envelope", "files": ["env"] }
    },
    {
      "id": "facts.api",
      "kind": "facts",
      "title": { "en": "API routes", "fr": "Routes de l'API" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "api" }],
      "freshness": { "rule": "envelope", "files": ["api"] }
    },
    {
      "id": "facts.screens",
      "kind": "facts",
      "title": { "en": "Screens of the front-end routers", "fr": "Écrans des routeurs du front" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "screens" }],
      "freshness": { "rule": "envelope", "files": ["screens"] }
    },
    {
      "id": "facts.stack",
      "kind": "facts",
      "title": { "en": "Stacks, languages and the code the kit reads", "fr": "Piles, langages et code lu par le kit" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "stack" }],
      "freshness": { "rule": "envelope", "files": ["stack"] }
    },
    {
      "id": "facts.db",
      "kind": "facts",
      "title": { "en": "Data model", "fr": "Modèle de données" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "db" }],
      "freshness": { "rule": "envelope", "files": ["db"] }
    },
    {
      "id": "facts.infra",
      "kind": "facts",
      "title": { "en": "Infrastructure: resources, workloads, images, environments", "fr": "Infrastructure : ressources, charges, images, environnements" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "infra" }],
      "freshness": { "rule": "envelope", "files": ["infra"] }
    },
    {
      "id": "facts.behaviours",
      "kind": "facts",
      "title": { "en": "Behaviours seen in the code", "fr": "Comportements vus dans le code" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "behaviours" }],
      "freshness": { "rule": "envelope", "files": ["behaviours"] }
    },
    {
      "id": "facts.agents",
      "kind": "facts",
      "title": { "en": "AI agent instructions", "fr": "Instructions des agents IA" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "agents" }],
      "freshness": { "rule": "envelope", "files": ["agents"] }
    },
    {
      "id": "facts.secrets",
      "kind": "facts",
      "title": { "en": "Secrets in the repository", "fr": "Secrets dans le dépôt" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "secrets" }],
      "freshness": { "rule": "envelope", "files": ["secrets"] }
    },
    {
      "id": "facts.security",
      "kind": "facts",
      "title": { "en": "Security rules", "fr": "Règles de sécurité" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "security" }],
      "freshness": { "rule": "envelope", "files": ["security"] }
    },
    {
      "id": "facts.quality",
      "kind": "facts",
      "title": { "en": "Code quality", "fr": "Qualité du code" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "quality" }],
      "freshness": { "rule": "envelope", "files": ["quality"] }
    },
    {
      "id": "facts.tests",
      "kind": "facts",
      "title": { "en": "Tests", "fr": "Tests" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "tests" }],
      "freshness": { "rule": "envelope", "files": ["tests"] }
    },
    {
      "id": "facts.modules",
      "kind": "facts",
      "title": { "en": "Modules and imports", "fr": "Modules et imports" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "modules" }],
      "freshness": { "rule": "envelope", "files": ["modules"] }
    },
    {
      "id": "facts.history",
      "kind": "facts",
      "title": { "en": "Git history", "fr": "Historique git" },
      "needs": ["inputs.repos"],
      "steps": [{ "command": "facts", "source": "history" }],
      "freshness": { "rule": "envelope", "files": ["history"] }
    },
    {
      "id": "facts.tools",
      "kind": "facts",
      "title": {
        "en": "External tools (gitleaks, osv-scanner, syft, knip)",
        "fr": "Outils externes (gitleaks, osv-scanner, syft, knip)"
      },
      "needs": ["inputs.repos"],
      "requires": ["tools"],
      "steps": [{ "command": "facts", "tools": true }],
      "freshness": { "rule": "envelope", "files": ["tool-gitleaks", "tool-osv-scanner", "tool-syft", "tool-knip"] }
    },
    {
      "id": "doc-audit",
      "kind": "report",
      "title": { "en": "Documentation audit", "fr": "Audit de la documentation" },
      "steps": [{ "command": "audit" }],
      "freshness": { "rule": "volatile" }
    }
  ]
}
